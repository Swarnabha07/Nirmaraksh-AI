# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for admin operations & backend testing)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 32-character random salt for hashing IP addresses
SALT=e4c8f2a1b9d037651a8e2f4c6b0d9e3a

# Groq Configuration (Required: /chat has no fallback and will not work without a valid key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b