# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for admin operations & backend testing)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 32-character random salt for hashing IP addresses
SALT=your-32-character-random-salt

# Groq Configuration (Required: /chat has no fallback and will not work without a valid key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b